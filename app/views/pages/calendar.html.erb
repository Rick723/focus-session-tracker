<div
  class="calendar-page"
  data-calendar-page
  data-completed-icon-large="<%= calendar_session_kind_icon_path(:completed, size: 64) %>"
  data-five-minutes-icon-large="<%= calendar_session_kind_icon_path(:reached_five_minutes, size: 64) %>"
>
  <header class="calendar-header">
    <div class="calendar-header__copy">
      <p class="calendar-eyebrow">Growing Records</p>
      <h1 class="calendar-title"><%= @display_month.strftime("%Y年%-m月") %> の育成記録</h1>
      <p class="calendar-description">
        5分から育った集中時間を、日ごとの記録として振り返れます。
      </p>
    </div>

    <nav class="calendar-actions" aria-label="ページ移動">
      <%= link_to "トップへ", root_path, class: "calendar-link-button calendar-link-button-secondary" %>
      <%= link_to "集中を始める", timer_path, class: "calendar-link-button calendar-link-button-secondary" %>
    </nav>
  </header>

  <section class="calendar-month-shell">
    <%= month_calendar start_date: @display_month,
      start_date_param: :month,
      events: @month_focus_sessions,
      attribute: :started_at do |date, _focus_sessions| %>
      <% summary = @daily_summaries.fetch(date, CalendarMonthPresenter.empty_summary) %>

      <div
        class="calendar-day-card"
        data-calendar-day
        data-date="<%= date.iso8601 %>"
        role="button"
        tabindex="0"
      >
        <div class="calendar-day-head">
          <time datetime="<%= date %>" class="calendar-day-number"><%= date.day %></time>
          <% if summary[:session_count].positive? %>
            <span class="calendar-session-count"><%= "#{summary[:session_count]}件" %></span>
          <% end %>
        </div>

        <% if summary[:session_count].positive? %>
          <div class="calendar-day-body">
            <p class="calendar-duration"><%= focus_duration_label(summary[:total_focus_seconds]) %></p>

            <div class="calendar-badges" aria-label="記録種別">
              <% summary[:pomo_doro_items].each do |item| %>
                <span class="<%= pomo_doro_badge_class(item[:kind]) %>">
                  <img
                    class="calendar-badge__icon"
                    src="<%= calendar_session_kind_icon_path(item[:kind], size: 32) %>"
                    alt="<%= calendar_session_kind_label(item[:kind]) %>"
                    width="32"
                    height="32"
                  >
                  <span class="calendar-badge__meta">
                    <span class="calendar-badge__label"><%= item[:label] %></span>
                    <span class="calendar-badge__count"><%= item[:count] %>回</span>
                  </span>
                </span>
              <% end %>
            </div>
          </div>
        <% elsif date.month == @display_month.month %>
          <p class="calendar-empty-text">この日の記録はまだありません</p>
        <% end %>
      </div>
    <% end %>
  </section>

  <div class="calendar-modal" data-calendar-modal hidden>
    <div class="calendar-modal-backdrop" data-calendar-close></div>
    <div class="calendar-modal-panel" role="dialog" aria-modal="true" aria-labelledby="calendar-modal-title">
      <div class="calendar-modal-header">
        <h2 id="calendar-modal-title" class="calendar-modal-title">日付詳細</h2>
        <button type="button" class="calendar-modal-close" data-calendar-close>閉じる</button>
      </div>

      <p class="calendar-modal-date" data-calendar-modal-date></p>
      <div class="calendar-modal-summary" data-calendar-modal-summary hidden></div>
      <p class="calendar-modal-empty" data-calendar-modal-empty hidden>この日の記録はありません</p>
      <div class="calendar-modal-list" data-calendar-modal-list></div>
    </div>
  </div>
</div>
