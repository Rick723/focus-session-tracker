<%# Background artwork desktop: app/assets/images/timer_images/farm_layout/*_16:9.png %>
<%# Background artwork mobile: app/assets/images/timer_images/farm_layout/*_3:4.png %>
<%# Creature artwork: app/assets/images/creature_images/normal_creature/*.png %>
<%# Timer frame artwork: app/assets/images/timer_images/tomato_timer/timer_display.png %>
<%# NOTE: completed modal artwork uses the repository file name "compleated_creature.png". %>
<% provide(:page_title, "はじめの５分集中タイマー | Timer") %>

<div
  id="timer-page"
  class="timer-page"
  data-stage="seed"
  data-scene="idle"
  style="
    --timer-bg-seed-desktop-image: url('<%= asset_path('timer_images/farm_layout/first_phase_16:9.png') %>');
    --timer-bg-sprout-desktop-image: url('<%= asset_path('timer_images/farm_layout/second_phase_16:9.png') %>');
    --timer-bg-harvest-desktop-image: url('<%= asset_path('timer_images/farm_layout/final_phase_16:9.png') %>');
    --timer-bg-seed-mobile-image: url('<%= asset_path('timer_images/farm_layout/first_phase_3:4.png') %>');
    --timer-bg-sprout-mobile-image: url('<%= asset_path('timer_images/farm_layout/second_phase_3:4.png') %>');
    --timer-bg-harvest-mobile-image: url('<%= asset_path('timer_images/farm_layout/final_phase_3:4.png') %>');
    --timer-frame-image: url('<%= asset_path('timer_images/tomato_timer/timer_display.png') %>');
  "
>
  <header class="timer-page__header">
    <div class="timer-page__header-row">
      <nav id="page-links" class="timer-page__nav" aria-label="ページ導線">
        <%= link_to "トップへ", root_path, class: "wood-sign wood-sign--header" %>
        <%= link_to "記録を見る", calendar_path, class: "wood-sign wood-sign--header" %>
      </nav>

      <button
        id="timer-notification-button"
        type="button"
        class="timer-notification-button"
        <%= "hidden" unless Rails.env.test? %>
      >
        PC通知をオン
      </button>
    </div>
  </header>

  <main id="timer-root" class="timer-scene">
    <div id="result-icon" class="timer-result" hidden aria-hidden="true">
      <div class="timer-result__scrim" aria-hidden="true"></div>
      <section class="timer-result__card" aria-label="完了演出">
        <img
          class="timer-result__image"
          src="<%= asset_path('creature_images/normal_creature/compleated_creature.png') %>"
          alt="よろこんでいるポモちゃん"
        >
        <p class="timer-result__eyebrow">ポモドーロ完了</p>
        <p class="timer-result__title">しゅうかく！</p>
        <p class="timer-result__text">ポモちゃんが元気に実りました</p>
        <div class="timer-result__actions">
          <button
            id="timer-result-confirm"
            type="button"
            class="wood-sign wood-sign--button timer-result__confirm"
          >
            次のたねをまく
          </button>
        </div>
      </section>
    </div>

    <section class="timer-hero" aria-live="polite">
      <div class="timer-stage">
        <figure
          id="creature-icon"
          class="timer-creature"
          data-creature-stage="seed"
          data-seed-image="<%= asset_path('creature_images/normal_creature/seed_creature.png') %>"
          data-sprout-image="<%= asset_path('creature_images/normal_creature/doro-chan0 Image.png') %>"
          data-harvest-image="<%= asset_path('creature_images/normal_creature/pomo-chan Image.png') %>"
        >
          <img
            id="creature-image"
            class="timer-creature__image"
            src="<%= asset_path('creature_images/normal_creature/seed_creature.png') %>"
            alt="たね"
          >
          <figcaption id="creature-label" class="timer-creature__label">たね</figcaption>
        </figure>

        <section class="tomato-timer" aria-labelledby="time">
          <div class="tomato-timer__frame" aria-hidden="true"></div>
          <div class="tomato-timer__display">
            <div id="time" class="tomato-timer__time" aria-live="polite">25:00</div>
            <p id="timer-phase" class="tomato-timer__phase">たねのじかん</p>
          </div>
        </section>
      </div>
    </section>

    <div id="timer-actions" class="timer-actions">
      <button
        id="start-button"
        type="button"
        class="wood-sign wood-sign--button"
      >
        たねをまく
      </button>

      <button
        id="stop-button"
        type="button"
        hidden
        class="wood-sign wood-sign--button wood-sign--button-secondary"
      >
        ひとやすみ
      </button>
    </div>

    <p id="timer-status-message" class="timer-status-board" role="status" aria-live="polite">
      たねをまいて集中タイムを始めましょう！
    </p>
  </main>
</div>
